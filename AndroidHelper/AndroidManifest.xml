<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mallenkb.phonerelay.helper"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Wireless debugging exists from Android 11 (API 30). -->
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />

    <!-- Development permission: only `adb shell pm grant` can give it. It lets
         the app write Settings.Global.adb_wifi_enabled. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:label="Phone Relay Helper">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Target of the Wi-Fi network callback PendingIntent; only the
             system delivers to it. -->
        <receiver
            android:name=".NetworkReceiver"
            android:exported="false" />
    </application>
</manifest>
